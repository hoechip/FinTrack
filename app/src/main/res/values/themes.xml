<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FinTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/emerald_green</item>
        <item name="colorSecondary">@color/soft_red</item>

        <item name="colorPrimaryContainer">@color/light_lavender</item>
        <item name="colorOnPrimaryContainer">@color/emerald_green</item>

        <item name="android:windowBackground">@color/background_gray</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FinTrack" parent="Base.Theme.FinTrack" />

    <style name="AppTextAppearance.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/nav_unselected</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppTextAppearance.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/emerald_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CalcButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Rounded.Calculator</item>
    </style>

    <style name="ShapeAppearance.Rounded.Calculator" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CalcButton.Num">
        <item name="backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="CalcButton.Op">
        <item name="backgroundTint">#E5E7EB</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="CalcButton.Green">
        <item name="backgroundTint">#00A86B</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>