<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_item_envelope_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/black" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txt_item_envelope_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/txt_item_envelope_amount"
        app:layout_constraintStart_toEndOf="@+id/card_item_icon_container"
        app:layout_constraintTop_toTopOf="@+id/card_item_icon_container"
        tools:text="1. Ăn uống" />

    <TextView
        android:id="@+id/txt_item_envelope_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_item_envelope_name"
        tools:text="4.500.000 đ" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_item_envelope_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:indicatorColor="@color/soft_red"
        app:layout_constraintEnd_toStartOf="@+id/txt_item_envelope_percent"
        app:layout_constraintStart_toStartOf="@+id/txt_item_envelope_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_item_envelope_name"
        app:trackColor="#E0E0E0"
        app:trackCornerRadius="4dp"
        app:trackThickness="10dp"
        tools:progress="65" />

    <TextView
        android:id="@+id/txt_item_envelope_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/pb_item_envelope_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pb_item_envelope_progress"
        tools:text="65%" />

</androidx.constraintlayout.widget.ConstraintLayout>