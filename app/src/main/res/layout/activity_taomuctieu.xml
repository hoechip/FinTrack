<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_m11_luu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txt_m11_tieude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tạo mục tiêu tiết kiệm"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <EditText
                android:id="@+id/edt_m11_ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Tên mục tiêu"
                android:inputType="text" />

            <EditText
                android:id="@+id/edt_m11_sotienmuctieu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Số tiền mục tiêu"
                android:inputType="number" />

            <EditText
                android:id="@+id/edt_m11_sotienhientai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Số tiền hiện tại"
                android:inputType="number" />

            <EditText
                android:id="@+id/edt_m11_ngayhanchot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Hạn chót, ví dụ: 30/12/2026"
                android:inputType="date" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_m11_luu"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:backgroundTint="@color/emerald_green"
        android:text="LƯU MỤC TIÊU"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
